# Copie este arquivo para .env e preencha os valores. Nunca commite o .env real.
# Ver plan.json -> data_sources para detalhes de cada fonte (limites, se é obrigatória, etc).

# --- Banco de dados ---
# SQLite local (padrão). Fica em instance/, já ignorado pelo .gitignore.
DATABASE_URL=sqlite:///instance/market_imbalances.db

# --- Web app (Flask) ---
FLASK_HOST=0.0.0.0
FLASK_PORT=8000
# Usada só para sessão/flash messages do Flask; não há login/autenticação no app.
FLASK_SECRET_KEY=change-me

# --- Ações (data_sources.acoes) ---
# brapi.dev: grátis, key recomendada para além dos 4 tickers de teste da B3.
BRAPI_TOKEN=

# --- Câmbio (data_sources.cambio) ---
# BCB SGS/PTAX e Frankfurter.app não exigem key.

# --- Cestas de moedas (data_sources.cestas_de_moedas) ---
# FRED (DTWEXBGS): key grátis via cadastro em https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
